# run-all.sh writes terraform/terraform.tfvars for you (git-ignored).
# To run Terraform by hand: copy this file to terraform.tfvars and edit.
aws_region       = "CHANGE_ME"              # e.g. the output of: aws configure get region
instance_type    = "t3.medium"
key_name         = "depi-test"              # EC2 key pair name
private_key_path = "~/.ssh/depi-test.pem"   # where the .pem lives on your laptop
allowed_cidr     = "0.0.0.0/0"              # better: "YOUR_PUBLIC_IP/32"
# public_key     = "ssh-rsa AAAA..."        # only if depi-test does NOT exist in this region
